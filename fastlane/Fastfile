default_platform(:ios)

BUNDLE_ID = "com.chriscorp.celer"
APP_NAME = "Celer"
TEAM_ID = "32DZ2XTUA7"
SCHEME = "bitchat_iOS"
WORKSPACE = "bitchat.xcodeproj"

platform :ios do
  # ── Helpers ──────────────────────────────────────────────────────────────

  desc "Authenticate with App Store Connect API"
  private_lane :setup_asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Sync code signing certificates and provisioning profiles (read-only)"
  private_lane :sync_signing do |options|
    type = options[:type] || "appstore"
    match(
      type: type,
      app_identifier: [BUNDLE_ID, "#{BUNDLE_ID}.ShareExtension"],
      team_id: TEAM_ID,
      readonly: true
    )
  end

  desc "Bump build number and build the app"
  private_lane :build_ipa do
    increment_build_number(
      build_number: ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M")),
      xcodeproj: WORKSPACE
    )
    build_app(
      project: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      include_bitcode: false,
      output_name: "#{APP_NAME}.ipa"
    )
  end

  # ── Lanes ─────────────────────────────────────────────────────────────────

  desc "Run all unit tests"
  lane :test do
    run_tests(
      project: WORKSPACE,
      scheme: SCHEME,
      devices: ["iPhone 15"],
      clean: true
    )
  end

  desc "Build the app (no upload)"
  lane :build do
    setup_asc_api_key
    sync_signing(type: "appstore")
    build_ipa
  end

  desc "Build and upload a new beta to TestFlight"
  lane :beta do
    setup_asc_api_key
    sync_signing(type: "appstore")
    build_ipa
    upload_to_testflight(
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and release to the App Store"
  lane :release do
    setup_asc_api_key
    sync_signing(type: "appstore")
    build_ipa
    upload_to_app_store(
      app_identifier: BUNDLE_ID,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: false
    )
  end

  # ── Error handling ─────────────────────────────────────────────────────────

  error do |lane, exception|
    UI.error("Lane '#{lane}' failed with: #{exception.message}")
  end
end
