# App Store Connect credentials
# APPLE_ID - Your Apple ID email address (e.g. you@example.com)
APPLE_ID=

# App Store Connect API Key (recommended over username/password)
# ASC_KEY_ID - Key ID from App Store Connect > Users and Access > Keys
ASC_KEY_ID=
# ASC_ISSUER_ID - Issuer ID from App Store Connect > Users and Access > Keys
ASC_ISSUER_ID=
# ASC_KEY_CONTENT - Base64-encoded contents of the .p8 API key file
ASC_KEY_CONTENT=

# Code signing
# MATCH_PASSWORD - Password used to encrypt the certificates in the match repository
MATCH_PASSWORD=
# MATCH_GIT_URL - Git repository URL where certificates and profiles are stored
MATCH_GIT_URL=

# Build settings
SCHEME=bitchat_iOS
WORKSPACE=bitchat.xcodeproj
BUNDLE_ID=com.chriscorp.celer
APP_NAME=Celer
TEAM_ID=32DZ2XTUA7
